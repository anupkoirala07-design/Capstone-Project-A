{
  "info": {
    "name": "Secure Retail – Product CRUD and Security Tests",
    "description": "Weeks 8–9 product CRUD tests plus login and admin security checks.\n\nBefore running: start the server (node server.js in the backend folder) and run node set-demo-passwords.js once.\n\nRun the whole collection with Run collection, in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin login",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as an admin. Postman keeps the session cookie (sr.sid) for the requests after this one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"anika.sharma@secureretail.com.au\",\n  \"Password\": \"Admin@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Logged in as Admin\", () => pm.expect(pm.response.json().user.Role).to.eql(\"Admin\"));"
                ]
              }
            }
          ]
        }
      ]
    },
