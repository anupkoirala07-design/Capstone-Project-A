    {
      "name": "3. CREATE / UPDATE / DELETE (admin)",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ProductName\": \"{{productName}}\",\n  \"Description\": \"Created by the Postman test collection\",\n  \"CategoryID\": 2,\n  \"BrandID\": 2,\n  \"WarrantyMonths\": 12,\n  \"IsFeatured\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new name each run, so the test never clashes with an earlier run",
                  "pm.collectionVariables.set(\"productName\", \"Postman Test Phone \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Product was saved with an ID\", () => pm.expect(body.product.ProductID).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"productId\", body.product.ProductID);"
                ]
              }
            }
          ]
        },
